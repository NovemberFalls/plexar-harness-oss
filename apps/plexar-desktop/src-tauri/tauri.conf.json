{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plexar Harness",
  "version": "0.4.6",
  "identifier": "com.boordits.plexar-harness",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Plexar Harness",
        "width": 1280,
        "height": 840,
        "minWidth": 720,
        "minHeight": 480,
        "backgroundColor": "#0a0a0b",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "plexar-runtime/": "plexar-runtime/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxN0Y4OEQ4QTMwQjQ2MkMKUldRc1JndWoySWgvUVlHWnVhcXhVU3pTQU5pM00xTGZTb2ZyRUFvZWxXc0MveXdqWis4RXhrMVoK",
      "endpoints": [
        "https://downloads.plexar.tech/harness/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
